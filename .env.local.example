# Optional (server-side only, not exposed to the browser). Where the
# same-origin /api/v1/* proxy (see next.config.mjs) forwards requests to.
# Defaults to the local backend, so this is usually not needed for local dev.
BACKEND_API_URL=http://localhost:8000/api/v1

# Optional escape hatch. Only set this if you deliberately want the browser
# to call the backend directly (cross-origin) instead of going through the
# same-origin proxy above. Do NOT set this in production — it reintroduces
# the cross-site auth-cookie problem the proxy exists to avoid.
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
