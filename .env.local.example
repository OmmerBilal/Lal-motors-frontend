# Server-side only — not exposed to the browser.
# Origin of the FastAPI backend. Next.js rewrites /api/v1/* to
# ${BACKEND_ORIGIN}/api/v1/* (see next.config.mjs).
#
# Do not include /api/v1 in this value — the rewrite adds it.
# After changing this file, restart `npm run dev` (next.config is loaded
# at process start; Fast Refresh will not update the rewrite destination).

# Local development (use 127.0.0.1, not localhost — see next.config.mjs):
BACKEND_ORIGIN=http://127.0.0.1:8000

# Production (Vercel):
# BACKEND_ORIGIN=https://lal-motors-backend.vercel.app

# Optional escape hatch. Only set this if you deliberately want the browser
# to call the backend directly (cross-origin) instead of going through the
# same-origin proxy. Do NOT set this in production — it reintroduces the
# cross-site auth-cookie problem the proxy exists to avoid.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
